# NON-PAYABLE ISOLATED TEST TEMPLATE. Never use these synthetic recipients for payments.
APP_MODE=production
PAYMENTS_ENABLED=false
ORDER_INTAKE_ENABLED=false
FOUNDER_AUTH_ENABLED=false
FOUNDER_APPROVAL_ENABLED=false
CUSTOMER_PAYMENT_CLAIMS_ENABLED=false
SECURE_PDF_DELIVERY_ENABLED=false

# Replace only in a private, isolated test environment. Never commit a real URL/password.
DATABASE_URL=postgresql+psycopg://alet_test_user:REPLACE_ME@db.internal:5432/parentwise_test
ORDER_TOKEN_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=https://private-test.example.invalid
TELEBIRR_ACCOUNT_NUMBER=0912345678
TELEBIRR_ACCOUNT_HOLDER=SYNTHETIC_ALETCLOUD_TEST
CBE_ACCOUNT_NUMBER=0000000000000
CBE_ACCOUNT_HOLDER=SYNTHETIC_ALETCLOUD_TEST
DB_POOL_SIZE=2
DB_POOL_TIMEOUT_SECONDS=5
